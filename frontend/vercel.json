{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://qms-api-x6t0.onrender.com/api/:path*" },
    { "source": "/health/:path*", "destination": "https://qms-api-x6t0.onrender.com/health/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
