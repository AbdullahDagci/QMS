QMS_DB_NAME=qms
QMS_DB_OWNER_USER=qms_owner
QMS_DB_APP_USER=qms_app
QMS_DB_OWNER_PASSWORD_FILE=/absolute/path/to/secrets/db-owner-password.txt
QMS_DB_APP_PASSWORD_FILE=/absolute/path/to/secrets/db-app-password.txt
QMS_ALLOWED_HOSTS=qms.example.com
QMS_INTEGRITY_HMAC_KEY_FILE=/absolute/path/to/secrets/integrity-hmac-key.txt
QMS_FILE_MINIMUM_RETENTION_YEARS=10
QMS_BOOTSTRAP_ADMIN_EMAIL=qms-admin@example.com
QMS_BOOTSTRAP_ADMIN_DISPLAY_NAME="QMS İlk Yöneticisi"
QMS_BOOTSTRAP_ADMIN_PASSWORD_FILE=/absolute/path/to/secrets/bootstrap-admin-password.txt
QMS_SMTP_HOST=smtp.example.com
QMS_SMTP_PORT=587
QMS_SMTP_SENDER=qms@example.com
QMS_SMTP_USE_TLS=true
QMS_SMTP_USERNAME=
QMS_SMTP_PASSWORD_FILE=/absolute/path/to/secrets/smtp-password.txt
QMS_HTTPS_PORT=8443
QMS_TLS_CERT_PATH=/absolute/path/to/fullchain.pem
QMS_TLS_KEY_PATH=/absolute/path/to/privkey.pem
